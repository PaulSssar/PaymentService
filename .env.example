# API
API_KEY=super-secret-api-key

# PostgreSQL
POSTGRES_USER=payment_user
POSTGRES_PASSWORD=payment_pass
POSTGRES_DB=payment_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL генерируется автоматически из POSTGRES_* переменных

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
# RABBITMQ_URL генерируется автоматически из RABBITMQ_* переменных

# App
DEBUG=true
LOG_LEVEL=INFO
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2.0
OUTBOX_BATCH_SIZE=50

# Ports (host:container)
RABBITMQ_MGMT_PORT=15672
API_PORT=8000
DEBUG=true
LOG_LEVEL=INFO
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3
OUTBOX_POLL_INTERVAL=2.0
OUTBOX_BATCH_SIZE=50

# Ports (host:container)
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
API_PORT=8000
